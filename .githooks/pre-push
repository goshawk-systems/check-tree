#!/usr/bin/env bash
# check-tree's own pre-push: a secret scan of the commits being pushed, no tests (the pipeline runs those).
# gitleaks scans exactly the pushed range; with no gitleaks installed the push is refused, because a push
# with no scan is the gap this hook exists to close. Install it with `brew install gitleaks`.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, so the pushed commits cannot be scanned for secrets. Install it (brew install gitleaks) and push again." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # a branch delete pushes no content
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    range=${base:+$base..}$local_sha
  else
    range=$remote_sha..$local_sha
  fi
  echo "pre-push: gitleaks over $range"
  if ! gitleaks git --no-banner --redact --log-opts="$range" .; then
    echo "pre-push: gitleaks found a secret in $range; remove it from those commits before pushing." >&2
    status=1
  fi
done
exit $status
